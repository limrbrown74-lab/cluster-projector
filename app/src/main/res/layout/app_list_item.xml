<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:minHeight="@dimen/app_row_min_height"
    android:paddingStart="@dimen/card_padding"
    android:paddingEnd="@dimen/card_padding"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <ImageView
        android:id="@+id/appIcon"
        android:layout_width="@dimen/app_icon"
        android:layout_height="@dimen/app_icon"
        android:layout_marginEnd="@dimen/app_icon_gap" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/appName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_app_name"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/appPkg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#8B8FA3"
            android:textSize="@dimen/text_app_package"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</LinearLayout>
