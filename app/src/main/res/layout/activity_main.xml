<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="12dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仪表投屏"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择应用投到仪表盘"
                android:textColor="#8B8FA3"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="就绪"
            android:textColor="#00D4FF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Display Selector Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目标显示设备"
            android:textColor="#5B6075"
            android:textSize="12sp"
            android:layout_marginBottom="8dp" />

        <Spinner
            android:id="@+id/displaySpinner"
            android:layout_width="match_parent"
            android:layout_height="40dp" />
    </LinearLayout>

    <!-- Control Panel Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="图层控制（在中控屏调整仪表盘上的窗口）"
            android:textColor="#5B6075"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="水平位置 X" android:textColor="#FFFFFF" android:textSize="12sp" />
        <SeekBar android:id="@+id/seekX" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="25" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="垂直位置 Y" android:textColor="#FFFFFF" android:textSize="12sp" />
        <SeekBar android:id="@+id/seekY" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="25" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="宽度" android:textColor="#FFFFFF" android:textSize="12sp" />
        <SeekBar android:id="@+id/seekW" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="50" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="高度" android:textColor="#FFFFFF" android:textSize="12sp" />
        <SeekBar android:id="@+id/seekH" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="50" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="透明度" android:textColor="#FFFFFF" android:textSize="12sp" />
        <SeekBar android:id="@+id/seekAlpha" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:max="100" android:progress="100" />
    </LinearLayout>

    <!-- Buttons -->
    <Button
        android:id="@+id/testBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="测试投屏（显示测试画面）"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_primary"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="停止投屏"
        android:textSize="14sp"
        android:textColor="#FF6B6B"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="12dp" />

    <!-- App List header label -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="已安装应用（点击投屏）"
        android:textColor="#5B6075"
        android:textSize="12sp"
        android:layout_marginBottom="8dp" />

    <!-- App List: takes remaining space, scrolls independently -->
    <ListView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:divider="#2A2E3D"
        android:dividerHeight="1dp" />

</LinearLayout>
