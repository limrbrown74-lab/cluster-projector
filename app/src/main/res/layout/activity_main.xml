<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:orientation="vertical"
    android:padding="@dimen/screen_padding">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_md">

        <ImageView
            android:layout_width="@dimen/header_icon"
            android:layout_height="@dimen/header_icon"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="@dimen/header_icon_gap" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仪表投屏"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_app_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="选择应用投到仪表盘"
                android:textColor="#8B8FA3"
                android:textSize="@dimen/text_subtitle" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:maxWidth="420dp"
            android:maxLines="3"
            android:gravity="end|center_vertical"
            android:text="就绪"
            android:textColor="#00D4FF"
            android:textSize="@dimen/text_caption"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Permission status -->
    <LinearLayout
        android:id="@+id/permissionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="@dimen/card_padding"
        android:layout_marginBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="权限检查"
                android:textColor="#B8BDD2"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:maxWidth="380dp"
                android:maxLines="3"
                android:gravity="end|center_vertical"
                android:text="正在检查..."
                android:textColor="#FFC857"
                android:textSize="@dimen/text_caption"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/permissionStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="2dp"
            android:text="正在检查权限..."
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_button_secondary"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/btn_secondary"
            android:minHeight="@dimen/touch_button_secondary"
            android:paddingStart="@dimen/card_padding"
            android:paddingEnd="@dimen/card_padding"
            android:textAllCaps="false"
            android:text="重新检查权限"
            android:textColor="#00D4FF"
            android:textSize="@dimen/text_button" />
    </LinearLayout>

    <!-- Display Selector Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="@dimen/card_padding"
        android:layout_marginBottom="@dimen/space_md">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="目标显示设备"
            android:textColor="#B8BDD2"
            android:textSize="@dimen/text_section"
            android:layout_marginBottom="@dimen/space_sm" />

        <Spinner
            android:id="@+id/displaySpinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_spinner"
            android:minHeight="@dimen/touch_spinner" />
    </LinearLayout>

    <!-- Control Panel Card -->
    <LinearLayout
        android:id="@+id/controlCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/card_bg"
        android:padding="@dimen/card_padding"
        android:layout_marginBottom="@dimen/space_md">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="图层控制（点击展开）"
            android:textColor="#B8BDD2"
            android:textSize="@dimen/text_section"
            android:lineSpacingExtra="2dp"
            android:maxLines="2" />

        <LinearLayout
            android:id="@+id/controlsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="@dimen/space_sm"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="水平位置 X"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body" />
            <SeekBar
                android:id="@+id/seekX"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_seekbar"
                android:minHeight="@dimen/touch_seekbar"
                android:max="100"
                android:progress="25" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="垂直位置 Y"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body" />
            <SeekBar
                android:id="@+id/seekY"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_seekbar"
                android:minHeight="@dimen/touch_seekbar"
                android:max="100"
                android:progress="25" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="宽度"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body" />
            <SeekBar
                android:id="@+id/seekW"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_seekbar"
                android:minHeight="@dimen/touch_seekbar"
                android:max="100"
                android:progress="50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高度"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body" />
            <SeekBar
                android:id="@+id/seekH"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_seekbar"
                android:minHeight="@dimen/touch_seekbar"
                android:max="100"
                android:progress="50" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="透明度"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body" />
            <SeekBar
                android:id="@+id/seekAlpha"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_seekbar"
                android:minHeight="@dimen/touch_seekbar"
                android:max="100"
                android:progress="100" />
        </LinearLayout>
    </LinearLayout>

    <Button
        android:id="@+id/testBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_button_primary"
        android:minHeight="@dimen/touch_button_primary"
        android:text="先预检仪表，再测试投屏"
        android:textSize="@dimen/text_button"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:background="@drawable/btn_primary"
        android:layout_marginBottom="@dimen/space_sm" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_button_secondary"
        android:minHeight="@dimen/touch_button_secondary"
        android:text="停止投屏"
        android:textSize="@dimen/text_button"
        android:textColor="#FF6B6B"
        android:textAllCaps="false"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="@dimen/space_sm" />

    <Button
        android:id="@+id/logBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_button_secondary"
        android:minHeight="@dimen/touch_button_secondary"
        android:text="查看日志文件"
        android:textSize="@dimen/text_button"
        android:textColor="#B8BDD2"
        android:textAllCaps="false"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="@dimen/space_md" />

    <!-- App List header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已安装应用（点击投屏）"
            android:textColor="#B8BDD2"
            android:textSize="@dimen/text_section"
            android:lineSpacingExtra="2dp"
            android:maxLines="2" />

        <CheckBox
            android:id="@+id/showSystemAppsCheck"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_checkbox"
            android:minHeight="@dimen/touch_checkbox"
            android:checked="true"
            android:buttonTint="#00D4FF"
            android:text="系统应用"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <ListView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:divider="#2A2E3D"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/emptyAppList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:padding="@dimen/card_padding"
        android:lineSpacingExtra="2dp"
        android:text="未获取到可启动应用。

如果是手机系统，请在系统设置里允许本应用“获取应用列表”；
FX11 车机如出现该提示，请检查 QUERY_ALL_PACKAGES/包可见性策略。"
        android:textColor="#8B8FA3"
        android:textSize="@dimen/text_body"
        android:visibility="gone" />
</LinearLayout>
