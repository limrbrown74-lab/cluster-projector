<?xml version="1.0" encoding="utf-8"?>
<org.clusterprojector.app.ClusterScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:fillViewport="false">

    <LinearLayout
        android:id="@+id/rootContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_md">

        <ImageView
            android:layout_width="@dimen/header_icon"
            android:layout_height="@dimen/header_icon"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="@dimen/header_icon_gap" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仪表投屏"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_app_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="把内容投到仪表盘"
                android:textColor="#8B8FA3"
                android:textSize="@dimen/text_subtitle" />

            <TextView
                android:id="@+id/versionText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="版本"
                android:textColor="#6F758A"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:maxWidth="420dp"
            android:maxLines="3"
            android:gravity="end|center_vertical"
            android:text="就绪"
            android:textColor="#00D4FF"
            android:textSize="@dimen/text_caption"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- 权限检查（默认折叠，点击展开） -->
    <LinearLayout
        android:id="@+id/permissionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/card_bg"
        android:padding="@dimen/card_padding"
        android:layout_marginBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="权限检查（点击展开）"
                android:textColor="#B8BDD2"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:maxWidth="380dp"
                android:maxLines="3"
                android:gravity="end|center_vertical"
                android:text="正在检查..."
                android:textColor="#FFC857"
                android:textSize="@dimen/text_caption"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/permissionDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/permissionStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="2dp"
                android:text="正在检查权限..."
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body" />

            <Button
                android:id="@+id/permissionButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/touch_button_secondary"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/btn_secondary"
                android:minHeight="@dimen/touch_button_secondary"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="@dimen/card_padding"
                android:textAllCaps="false"
                android:text="重新检查权限"
                android:textColor="#00D4FF"
                android:textSize="@dimen/text_button" />
        </LinearLayout>
    </LinearLayout>

    <!-- 当前投屏方式 + 更多入口 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg"
        android:padding="@dimen/card_padding"
        android:layout_marginBottom="@dimen/space_md">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="当前投屏方式"
            android:textColor="#B8BDD2"
            android:textSize="@dimen/text_section"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/currentModeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_md"
            android:text="应用投屏"
            android:textColor="#4CD964"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <Button
            android:id="@+id/moreModesBtn"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/touch_button_secondary"
            android:layout_marginStart="@dimen/space_md"
            android:minHeight="@dimen/touch_button_secondary"
            android:text="更多投屏方式 ›"
            android:textSize="@dimen/text_button"
            android:textColor="#00D4FF"
            android:textAllCaps="false"
            android:background="@drawable/btn_secondary" />
    </LinearLayout>

    <!-- ============ 方式一容器：应用投屏 ============ -->
    <LinearLayout
        android:id="@+id/modeAppCastContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <Spinner
            android:id="@+id/displaySpinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_spinner"
            android:minHeight="@dimen/touch_spinner"
            android:layout_marginBottom="@dimen/space_md" />

        <LinearLayout
            android:id="@+id/controlCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/space_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="图层控制（点击展开）：位置 / 大小 / 透明度"
                android:textColor="#B8BDD2"
                android:textSize="@dimen/text_section"
                android:lineSpacingExtra="2dp"
                android:maxLines="2" />

            <LinearLayout
                android:id="@+id/controlsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_sm"
                android:visibility="gone">

                <TextView
                    android:id="@+id/mergeHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_sm"
                    android:background="#1A00D4FF"
                    android:padding="@dimen/space_sm"
                    android:lineSpacingExtra="1dp"
                    android:text="合并投屏中：画面铺满仪表盘，位置/大小锁定，仅透明度可调"
                    android:textColor="#00D4FF"
                    android:textSize="@dimen/text_caption"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="水平位置 X"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_body" />
                <SeekBar
                    android:id="@+id/seekX"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_seekbar"
                    android:minHeight="@dimen/touch_seekbar"
                    android:max="100"
                    android:progress="25" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="垂直位置 Y"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_body" />
                <SeekBar
                    android:id="@+id/seekY"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_seekbar"
                    android:minHeight="@dimen/touch_seekbar"
                    android:max="100"
                    android:progress="25" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="宽度"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_body" />
                <SeekBar
                    android:id="@+id/seekW"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_seekbar"
                    android:minHeight="@dimen/touch_seekbar"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="高度"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_body" />
                <SeekBar
                    android:id="@+id/seekH"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_seekbar"
                    android:minHeight="@dimen/touch_seekbar"
                    android:max="100"
                    android:progress="50" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="透明度"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_body" />
                <SeekBar
                    android:id="@+id/seekAlpha"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/touch_seekbar"
                    android:minHeight="@dimen/touch_seekbar"
                    android:max="100"
                    android:progress="100" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="@dimen/space_sm">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="已安装应用（点击投到仪表盘）"
                android:textColor="#B8BDD2"
                android:textSize="@dimen/text_section"
                android:lineSpacingExtra="2dp"
                android:maxLines="2" />

            <CheckBox
                android:id="@+id/showSystemAppsCheck"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/touch_checkbox"
                android:minHeight="@dimen/touch_checkbox"
                android:checked="true"
                android:buttonTint="#00D4FF"
                android:text="系统应用"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_body" />
        </LinearLayout>

        <ListView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@drawable/card_bg"
            android:divider="#2A2E3D"
            android:dividerHeight="1dp" />

        <TextView
            android:id="@+id/emptyAppList"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:background="@drawable/card_bg"
            android:gravity="center"
            android:padding="@dimen/card_padding"
            android:lineSpacingExtra="2dp"
            android:text="未获取到可启动应用。

如果是手机系统，请在系统设置里允许本应用“获取应用列表”；
FX11 车机如出现该提示，请检查 QUERY_ALL_PACKAGES/包可见性策略。"
            android:textColor="#8B8FA3"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />
    </LinearLayout>

    <!-- ============ 方式二容器：仪表盘投屏 ============ -->
    <LinearLayout
        android:id="@+id/modeDashboardContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/space_md">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="仪表盘投屏（自绘数字仪表）"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/text_section"
                android:textStyle="bold"
                android:layout_marginBottom="@dimen/space_sm" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingExtra="2dp"
                android:text="不依赖原车画面，用自带特斯拉风格数字仪表（车速/转速/档位/灯光/地图）投到仪表盘。先“预览”在中控看效果，确认后“投物理屏”真正上仪表；再点一次恢复原厂仪表。"
                android:textColor="#8B8FA3"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_md">

                <Button
                    android:id="@+id/dashboardBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_button_secondary"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:minHeight="@dimen/touch_button_secondary"
                    android:text="预览（中控窗口）"
                    android:textSize="@dimen/text_button"
                    android:textColor="#00D4FF"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_secondary" />

                <Button
                    android:id="@+id/dashboardScreenBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_button_secondary"
                    android:layout_weight="1"
                    android:minHeight="@dimen/touch_button_secondary"
                    android:text="投物理屏"
                    android:textSize="@dimen/text_button"
                    android:textColor="#4CD964"
                    android:textAllCaps="false"
                    android:background="@drawable/btn_secondary" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ============ 方式三容器：仪表地图（AVM） ============ -->
    <LinearLayout
        android:id="@+id/modeAvmContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/avmCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="@dimen/card_padding"
            android:layout_marginBottom="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="仪表地图（AVM 官方通道）"
                    android:textColor="#B8BDD2"
                    android:textSize="@dimen/text_section"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/avmStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md"
                    android:maxWidth="280dp"
                    android:maxLines="2"
                    android:gravity="end|center_vertical"
                    android:text="未连接"
                    android:textColor="#FFC857"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="2dp"
                android:text="走官方 OneOS API，把原厂地图直接渲染到仪表盘（不依赖自绘画面），用于验证官方投屏通道。"
                android:textColor="#8B8FA3"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_md">

                <Button
                    android:id="@+id/avmStartBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_button_secondary"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_sm"
                    android:background="@drawable/btn_primary"
                    android:minHeight="@dimen/touch_button_secondary"
                    android:text="启用仪表地图"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/text_button" />

                <Button
                    android:id="@+id/avmStopBtn"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/touch_button_secondary"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:minHeight="@dimen/touch_button_secondary"
                    android:text="停止"
                    android:textAllCaps="false"
                    android:textColor="#FF6B6B"
                    android:textSize="@dimen/text_button" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- 方式一动作按钮（车机大屏自动横排） -->
    <Button
        android:id="@+id/testBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_button_primary"
        android:minHeight="@dimen/touch_button_primary"
        android:text="测试投屏"
        android:textSize="@dimen/text_button"
        android:textColor="#FFFFFF"
        android:textAllCaps="false"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:background="@drawable/btn_primary"
        android:layout_marginBottom="@dimen/space_sm" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_button_secondary"
        android:minHeight="@dimen/touch_button_secondary"
        android:text="停止投屏"
        android:textSize="@dimen/text_button"
        android:textColor="#FF6B6B"
        android:textAllCaps="false"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="@dimen/space_sm" />

    <Button
        android:id="@+id/logBtn"
        android:layout_width="match_parent"
        android:layout_height="@dimen/touch_button_secondary"
        android:minHeight="@dimen/touch_button_secondary"
        android:text="查看日志文件"
        android:textSize="@dimen/text_button"
        android:textColor="#B8BDD2"
        android:textAllCaps="false"
        android:paddingStart="@dimen/card_padding"
        android:paddingEnd="@dimen/card_padding"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="@dimen/space_md" />

    <!-- 共用底层：物理切屏自测 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="@dimen/card_padding"
        android:layout_marginBottom="@dimen/space_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="共用底层 · 物理切屏自测"
                android:textColor="#B8BDD2"
                android:textSize="@dimen/text_section"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/switchStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:maxWidth="280dp"
                android:maxLines="2"
                android:gravity="end|center_vertical"
                android:text="未切屏"
                android:textColor="#FFC857"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:lineSpacingExtra="2dp"
            android:text="上面投屏方式共用的底层能力：把仪表屏从 QNX 切到 Android 显示源。先单独自测：切屏成功仪表应黑屏或出现 Android 画面；再点一次恢复原厂仪表。"
            android:textColor="#8B8FA3"
            android:textSize="@dimen/text_caption" />

        <Button
            android:id="@+id/switchBtn"
            android:layout_width="match_parent"
            android:layout_height="@dimen/touch_button_secondary"
            android:layout_marginTop="@dimen/space_md"
            android:background="@drawable/btn_secondary"
            android:minHeight="@dimen/touch_button_secondary"
            android:text="手动切屏 / 恢复原厂"
            android:textAllCaps="false"
            android:textColor="#00D4FF"
            android:textSize="@dimen/text_button" />
    </LinearLayout>
</LinearLayout>
</org.clusterprojector.app.ClusterScrollView>
