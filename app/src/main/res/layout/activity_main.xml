<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F1117"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="仪表投屏"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="选择应用投到仪表盘"
                android:textColor="#8B8FA3"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxWidth="190dp"
            android:singleLine="true"
            android:text="就绪"
            android:textColor="#00D4FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Permission status -->
    <LinearLayout
        android:id="@+id/permissionCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="权限检查"
                android:textColor="#B8BDD2"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/permissionSummaryText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxWidth="220dp"
                android:singleLine="true"
                android:text="正在检查..."
                android:textColor="#FFC857"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/permissionStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lineSpacingExtra="1dp"
            android:text="正在检查权限..."
            android:textColor="#FFFFFF"
            android:textSize="11sp" />

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/btn_secondary"
            android:minHeight="36dp"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:text="重新检查权限"
            android:textColor="#00D4FF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Display Selector Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目标显示设备"
            android:textColor="#B8BDD2"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/displaySpinner"
            android:layout_width="match_parent"
            android:layout_height="36dp" />
    </LinearLayout>

    <!-- Control Panel Card -->
    <LinearLayout
        android:id="@+id/controlCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="@drawable/card_bg"
        android:padding="10dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="图层控制（点击展开；投屏后可调整位置/大小/透明度）"
            android:textColor="#B8BDD2"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/controlsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp"
            android:visibility="gone">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="水平位置 X" android:textColor="#FFFFFF" android:textSize="11sp" />
        <SeekBar android:id="@+id/seekX" android:layout_width="match_parent"
            android:layout_height="30dp" android:minHeight="24dp" android:max="100" android:progress="25" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="垂直位置 Y" android:textColor="#FFFFFF" android:textSize="11sp" />
        <SeekBar android:id="@+id/seekY" android:layout_width="match_parent"
            android:layout_height="30dp" android:minHeight="24dp" android:max="100" android:progress="25" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="宽度" android:textColor="#FFFFFF" android:textSize="11sp" />
        <SeekBar android:id="@+id/seekW" android:layout_width="match_parent"
            android:layout_height="30dp" android:minHeight="24dp" android:max="100" android:progress="50" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="高度" android:textColor="#FFFFFF" android:textSize="11sp" />
        <SeekBar android:id="@+id/seekH" android:layout_width="match_parent"
            android:layout_height="30dp" android:minHeight="24dp" android:max="100" android:progress="50" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="透明度" android:textColor="#FFFFFF" android:textSize="11sp" />
        <SeekBar android:id="@+id/seekAlpha" android:layout_width="match_parent"
            android:layout_height="30dp" android:minHeight="24dp" android:max="100" android:progress="100" />
        </LinearLayout>
    </LinearLayout>

    <!-- Buttons -->
    <Button
        android:id="@+id/testBtn"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:minHeight="42dp"
        android:text="测试投屏（显示测试画面）"
        android:textSize="13sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/btn_primary"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:minHeight="42dp"
        android:text="停止投屏"
        android:textSize="13sp"
        android:textColor="#FF6B6B"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="4dp" />

    <Button
        android:id="@+id/logBtn"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:minHeight="36dp"
        android:text="查看日志文件"
        android:textSize="11sp"
        android:textColor="#B8BDD2"
        android:background="@drawable/btn_secondary"
        android:layout_marginBottom="8dp" />

    <!-- App List header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="已安装应用（点击投屏）"
            android:textColor="#B8BDD2"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/showSystemAppsCheck"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:checked="true"
            android:buttonTint="#00D4FF"
            android:text="系统应用"
            android:textColor="#FFFFFF"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- App List: takes remaining space, scrolls independently -->
    <ListView
        android:id="@+id/appList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:divider="#2A2E3D"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/emptyAppList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/card_bg"
        android:gravity="center"
        android:padding="16dp"
        android:text="未获取到可启动应用。

如果是手机系统，请在系统设置里允许本应用“获取应用列表”；
FX11 车机如出现该提示，请检查 QUERY_ALL_PACKAGES/包可见性策略。"
        android:textColor="#8B8FA3"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
